APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email notifications (task assignment).
# Local development: run Mailpit (https://mailpit.axllent.org/) and open
# http://localhost:8025 to read the messages it captures.
# Production: set MAIL_HOST/PORT/USERNAME/PASSWORD to your SMTP provider.
# MAIL_QUEUE_NOTIFICATIONS=true only when a queue worker is running; otherwise
# mail is sent synchronously during the request.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
# Gmail app passwords contain spaces; keep the value quoted.
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@silindo.co.id"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_QUEUE_NOTIFICATIONS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hari libur nasional (API). Set auto-sync=false to disable fetching while
# the calendar keeps using rows already stored in the holidays table.
HOLIDAY_AUTO_SYNC=true
HOLIDAY_INCLUDE_JOINT_LEAVE=false
HOLIDAY_API_TIMEOUT=5
